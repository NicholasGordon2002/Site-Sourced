# dependencies (the engine has none — it runs on Bun's built-ins)
node_modules/

# HTTP cache: re-created on demand, can be large
out/cache/

# scratch
*.log
.DS_Store

# generated demos and their image cache
out/demos/
out/formtest/
out/cache/demo/
# per-client values (form ids, relay endpoints) — never committed
.env.local
# fetched provider documentation kept as evidence
out/fs-docs/

# lead data — never in git (rule 4: no lead lists)
out/leads-*.csv
out/leads-*.json
# verification bundles
out/verify/

# generated bundles are build output, never committed (added 9 Oct 2026, lead)
out/biz/
